# Copy to .env and fill in. Never commit the real .env.

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Safety — leave PAPER_TRADE=true until you've validated the full pipeline.
PAPER_TRADE=true
KILL_SWITCH=false

WEBHOOK_SHARED_SECRET=change-me-to-something-long-and-random

MARKET_OPEN=09:15
MARKET_CLOSE=14:45

QUANTITY_LOTS=1
LOT_SIZE=35
SL_POINTS=100
TARGET_POINTS=100

ON_SIGNAL_WHILE_OPEN=ignore
EOD_SQUARE_OFF=true

DB_PATH=./trades.db
HOST=0.0.0.0
PORT=8080
